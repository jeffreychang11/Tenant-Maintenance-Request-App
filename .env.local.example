# Supabase (Settings > API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) — transactional email fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Base URL used in email deep links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (dashboard.stripe.com/apikeys) — landlord subscription billing.
# Price IDs come from running `node scripts/stripe-setup.mjs` once you have
# a Stripe account, or create them manually in the Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER_1_3_MONTHLY=
STRIPE_PRICE_TIER_1_3_YEARLY=
STRIPE_PRICE_TIER_4_10_MONTHLY=
STRIPE_PRICE_TIER_4_10_YEARLY=
